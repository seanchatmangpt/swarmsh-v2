@prefix clp: <https://ggen.dev/ontology/capability-lineage-propagation#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

clp:capability a clp:QualifiedCapability ; clp:standing "ALIVE" ; dcterms:identifier "swarmsh_v2" .
clp:edge01 a clp:LineageEdge ; clp:preservesCapability true ; clp:semanticDelta 0 .
clp:edge02 a clp:LineageEdge ; clp:preservesCapability true ; clp:semanticDelta 0 .
clp:edge03 a clp:LineageEdge ; clp:preservesCapability true ; clp:semanticDelta 0 .
clp:edge04 a clp:LineageEdge ; clp:preservesCapability true ; clp:semanticDelta 0 .
clp:edge05 a clp:LineageEdge ; clp:preservesCapability true ; clp:semanticDelta 0 .
clp:edge06 a clp:LineageEdge ; clp:preservesCapability true ; clp:semanticDelta 0 .
clp:edge07 a clp:LineageEdge ; clp:preservesCapability true ; clp:semanticDelta 0 .
clp:plan a clp:PropagationPlan ; clp:capability clp:capability ; clp:edge clp:edge01, clp:edge02, clp:edge03, clp:edge04, clp:edge05, clp:edge06, clp:edge07 ; clp:authority "CONSTRUCT" ; clp:actuationPerformed false ; clp:forcePushAllowed false .
